---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ClipFrame from '../components/ClipFrame.astro';
import logo from '../assets/art/logo-full.png';
import sebastian from '../assets/team/sebastian.png';
import julie from '../assets/team/julie.png';
import fox from '../assets/art/fox.png';

const games = (await getCollection('games', ({ data }) => !data.draft)).sort((a, b) => a.data.order - b.data.order);
---

<Base>
  <section class="hero wrap">
    <div class="hero-text">
      <h1>Small games, drawn by&nbsp;hand.</h1>
      <p class="lede">
        We're a two-person studio in Copenhagen making odd, cosy and sometimes slightly unsettling worlds. Everything starts as a
        sketch on paper.
      </p>
      <div class="btn-row">
        <a class="btn" href="/games/">See what we're making</a>
        <a class="btn btn--ghost" href="/about/">Meet the two of us</a>
      </div>
    </div>
    <div class="hero-art">
      <Image src={logo} alt="Kinda Whimsical Games logo: two wide-eyed friends holding a game controller above a hand-lettered banner" width={620} loading="eager" fetchpriority="high" />
    </div>
  </section>

  <section class="section wrap" aria-labelledby="games-title">
    <div class="section-head">
      <h2 id="games-title">On the drawing board</h2>
      <a href="/games/">All {games.length} games</a>
    </div>
    <ul class="grid">
      {
        games.map((game, i) => (
          <li style={`--accent:${game.data.color}`}>
            <a class="card" href={`/games/${game.id}/`}>
              <ClipFrame game={game} tilt={i % 2 ? 0.6 : -0.6} stickerSide={i % 2 ? 'left' : 'right'} />
              <div class="card-text">
                <h3>{game.data.title}</h3>
                <p class="muted">{game.data.tagline}</p>
                <p class="status">{game.data.status}</p>
              </div>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="section wrap studio" aria-labelledby="studio-title">
    <div class="faces">
      <Image src={sebastian} alt="Sebastian" width={200} />
      <Image src={julie} alt="Julie" width={200} />
      <Image class="fox" src={fox} alt="" width={220} />
    </div>
    <div>
      <h2 id="studio-title">Two people, a lot of sketchbooks</h2>
      <p class="lede">
        Julie writes and draws. Sebastian programs and builds. Between us we make the art, the code, the stories and
        the music.
      </p>
      <p><a href="/about/">More about the studio</a></p>
    </div>
  </section>
</Base>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
    align-items: center;
    gap: clamp(2rem, 5vw, 5rem);
    padding-block: clamp(2rem, 6vw, 5rem) var(--space-l);
  }

  .hero-text {
    display: grid;
    gap: var(--space-m);
  }

  .hero-text h1 {
    font-size: clamp(3rem, 1.8rem + 5.2vw, 6rem);
    font-weight: 700;
    line-height: 0.98;
  }

  .hero-art img {
    width: 100%;
    max-width: 560px;
    margin-inline: auto;
    filter: drop-shadow(0 20px 40px rgb(10 5 20 / 0.5));
    animation: wiggle-in 1.1s cubic-bezier(0.3, 1.4, 0.5, 1) both;
    transform-origin: 50% 80%;
  }

  @keyframes wiggle-in {
    0% {
      opacity: 0;
      transform: scale(0.85) rotate(-6deg);
    }
    55% {
      opacity: 1;
      transform: scale(1.02) rotate(2.5deg);
    }
    100% {
      transform: scale(1) rotate(0);
    }
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 340px), 1fr));
    gap: clamp(3rem, 5vw, 4.5rem) clamp(2rem, 4vw, 3.5rem);
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .card {
    display: grid;
    gap: 1.6rem;
    color: inherit;
    text-decoration: none;
  }

  .card-text {
    display: grid;
    gap: 0.3rem;
  }

  .card:hover h3 {
    color: var(--accent);
  }

  .status {
    margin-top: 0.3rem;
    font-size: var(--step--1);
    font-weight: 650;
    color: var(--accent);
  }

  .studio {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    gap: clamp(2rem, 6vw, 5rem);
  }

  .studio > div:last-child {
    display: grid;
    gap: var(--space-m);
  }

  .faces {
    position: relative;
    display: flex;
    padding-right: 3rem;
  }

  .faces img {
    width: clamp(110px, 16vw, 170px);
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: 50%;
    border: 4px solid var(--plum-700);
  }

  .faces img + img {
    margin-left: -1.6rem;
  }

  .faces .fox {
    position: absolute;
    right: -1.5rem;
    bottom: -1.5rem;
    width: clamp(90px, 12vw, 130px);
    aspect-ratio: auto;
    border: 0;
    border-radius: 0;
    transform: rotate(8deg);
  }

  @media (max-width: 820px) {
    .hero,
    .studio {
      grid-template-columns: 1fr;
    }

    .hero-art {
      order: -1;
    }

    .hero-art img {
      max-width: 340px;
    }
  }
</style>
