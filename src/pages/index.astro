---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ClipFrame from '../components/ClipFrame.astro';
import logo from '../assets/art/logo-full.png';
import sebastian from '../assets/team/sebastian.png';
import julie from '../assets/team/julie.png';
import fox from '../assets/art/fox.png';
import cat from '../assets/art/cat.png';
import wizard from '../assets/art/wizard.png';
import fish from '../assets/art/fish.png';
import eye from '../assets/art/eye-detective.png';
import polar from '../assets/art/polar-bear.png';
import bunny from '../assets/art/umbrella-bunny.png';
import card from '../assets/art/card-arrow.png';
import catKnight from '../assets/art/cat-knight.png';

const games = (await getCollection('games', ({ data }) => !data.draft)).sort((a, b) => a.data.order - b.data.order);

// Characters floating around the logo. x/y are % of the hero, w is width in px,
// d is parallax depth, m marks the few that stay on small screens.
const floaters = [
  { img: fox, x: 3, y: 10, w: 160, r: -8, d: 1.2, m: true },
  { img: bunny, x: 25, y: 4, w: 96, r: 6, d: 0.6 },
  { img: wizard, x: 6, y: 52, w: 190, r: 4, d: 0.9 },
  { img: fish, x: 1, y: 82, w: 150, r: -14, d: 1.4 },
  { img: card, x: 70, y: 6, w: 120, r: -10, d: 0.5 },
  { img: cat, x: 83, y: 8, w: 160, r: 7, d: 1.1, m: true },
  { img: eye, x: 84, y: 48, w: 150, r: -6, d: 0.8 },
  { img: polar, x: 85, y: 80, w: 140, r: 10, d: 1.3 },
];
---

<Base>
  <!-- One-time intro curtain, shown on the first visit of a session -->
  <div class="splash" id="splash" aria-hidden="true" slot="overlay">
    <div class="splash-inner">
      <Image src={catKnight} alt="" width={180} densities={[1, 2]} loading="eager" />
      <p class="display">Loading whimsy</p>
    </div>
    <svg class="splash-edge" viewBox="0 0 1440 40" preserveAspectRatio="none">
      <path d="M0 0 H1440 V18 C1300 38 1160 6 1010 22 C860 38 760 8 610 24 C460 40 330 6 190 22 C110 31 50 18 0 26 Z"></path>
    </svg>
  </div>
  <script is:inline>
    (function () {
      var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      try {
        if (!reduce && !sessionStorage.getItem('kowg-intro')) {
          document.documentElement.setAttribute('data-intro', '');
          sessionStorage.setItem('kowg-intro', '1');
        }
      } catch (e) {}
    })();
  </script>

  <section class="hero" id="hero" aria-labelledby="hero-title">
    <div class="floaters" aria-hidden="true">
      {
        floaters.map((f, i) => (
          <div
            class:list={['floater', { 'keep-mobile': f.m }]}
            style={`--x:${f.x}%; --y:${f.y}%; --w:${f.w}px; --r:${f.r}deg; --d:${f.d}; --i:${i}; --dur:${5 + (i % 4) * 0.9}s`}
          >
            <span class="pop">
              <Image src={f.img} alt="" width={f.w} densities={[1, 2]} loading="eager" />
            </span>
          </div>
        ))
      }
    </div>

    <div class="hero-center">
      <Image
        class="logo"
        src={logo}
        alt="Kinda Whimsical Games"
        width={460}
        densities={[1, 2]}
        loading="eager"
        fetchpriority="high"
      />
      <h1 id="hero-title" class="hero-title">Small games, drawn by&nbsp;hand</h1>
      <div class="btn-row hero-cta">
        <a class="btn" href="/games/">See our games</a>
        <a class="btn btn--ghost" href="/about/">Meet the studio</a>
      </div>
    </div>
  </section>

  <section class="section wrap" aria-labelledby="games-title">
    <div class="section-head">
      <h2 id="games-title">On the drawing board</h2>
      <a href="/games/">All {games.length} games</a>
    </div>
    <ul class="grid">
      {
        games.map((game, i) => (
          <li
            style={`--accent:${game.data.color}; --reveal-delay:${(i % 3) * 0.08}s; --reveal-tilt:${i % 2 ? 2 : -2}deg`}
            data-reveal
          >
            <a class="card" href={`/games/${game.id}/`}>
              <ClipFrame game={game} tilt={i % 2 ? 0.6 : -0.6} stickerSide={i % 2 ? 'left' : 'right'} />
              <div class="card-text">
                <h3>{game.data.title}</h3>
                <p class="muted">{game.data.tagline}</p>
                <p class="status">{game.data.status}</p>
              </div>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="section wrap studio" aria-labelledby="studio-title" data-reveal>
    <div class="faces">
      <Image src={sebastian} alt="Sebastian" width={180} densities={[1, 2]} />
      <Image src={julie} alt="Julie" width={180} densities={[1, 2]} />
    </div>
    <div>
      <h2 id="studio-title">Two people, a lot of sketchbooks</h2>
      <p class="lede">
        We're a two-person studio in Copenhagen. Julie writes and draws, Sebastian programs and builds, and between us
        we make the art, the code, the stories and the music.
      </p>
      <p><a class="btn btn--ghost" href="/about/">More about us</a></p>
    </div>
  </section>
</Base>

<style>
  /* ---------- Intro curtain ---------- */
  .splash {
    display: none;
  }

  :global(html[data-intro]) .splash {
    position: fixed;
    inset: 0;
    z-index: 300;
    display: grid;
    place-items: center;
    background: var(--plum);
    color: var(--chalk);
    animation: curtain-up 0.7s cubic-bezier(0.7, 0, 0.3, 1) 1.15s forwards;
  }

  .splash-inner {
    display: grid;
    justify-items: center;
    gap: 1rem;
  }

  .splash-inner img {
    width: 140px;
    animation: hop 0.55s ease-in-out infinite alternate;
  }

  .splash-inner p {
    font-size: var(--step-1);
  }

  .splash-inner p::after {
    content: '...';
    display: inline-block;
    width: 1.5ch;
    text-align: left;
    animation: dots 0.9s steps(4) infinite;
    clip-path: inset(0 100% 0 0);
  }

  .splash-edge {
    position: absolute;
    top: 100%;
    left: 0;
    width: 100%;
    height: 36px;
    fill: var(--plum);
  }

  @keyframes curtain-up {
    to {
      transform: translateY(calc(-100% - 40px));
      visibility: hidden;
    }
  }

  @keyframes hop {
    from {
      transform: translateY(0) rotate(-5deg);
    }
    to {
      transform: translateY(-18px) rotate(5deg);
    }
  }

  @keyframes dots {
    from {
      clip-path: inset(0 100% 0 0);
    }
    to {
      clip-path: inset(0 -10% 0 0);
    }
  }

  /* ---------- Hero ---------- */
  .hero {
    --mx: 0;
    --my: 0;
    --start: 0s; /* pushed back while the curtain is up */
    position: relative;
    min-height: min(92vh, 860px);
    display: grid;
    place-items: center;
    padding: clamp(3rem, 7vw, 5rem) 1.25rem clamp(3rem, 6vw, 4rem);
    overflow: hidden;
  }

  :global(html[data-intro]) .hero {
    --start: 1.45s;
  }

  .hero-center {
    position: relative;
    z-index: 2;
    display: grid;
    justify-items: center;
    gap: clamp(1rem, 2.5vw, 1.75rem);
    text-align: center;
  }

  .logo {
    width: min(440px, 72vw);
    height: auto;
    transform-origin: 50% 85%;
    animation: logo-in 1s var(--bounce) var(--start) both;
  }

  .hero-title {
    font-size: clamp(1.7rem, 1rem + 2.8vw, 3.1rem);
    max-width: 18ch;
    animation: rise 0.7s var(--bounce) calc(var(--start) + 0.35s) both;
  }

  .hero-cta {
    justify-content: center;
    animation: rise 0.7s var(--bounce) calc(var(--start) + 0.5s) both;
  }

  @keyframes logo-in {
    0% {
      opacity: 0;
      transform: scale(0.6) rotate(-10deg);
    }
    60% {
      opacity: 1;
      transform: scale(1.04) rotate(3deg);
    }
    100% {
      transform: none;
    }
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
  }

  .floaters {
    position: absolute;
    inset: 0;
    width: min(1440px, 100%);
    margin-inline: auto;
  }

  /* Outer: position + mouse parallax */
  .floater {
    position: absolute;
    left: var(--x);
    top: var(--y);
    width: clamp(70px, calc(var(--w) * 0.75 + 1.5vw), var(--w));
    transform: translate(calc(var(--mx) * var(--d) * -22px), calc(var(--my) * var(--d) * -18px));
    transition: transform 0.6s cubic-bezier(0.2, 0.8, 0.3, 1);
  }

  /* Middle: pop in one after another */
  .pop {
    display: block;
    animation: pop-in 0.6s var(--bounce) calc(var(--start) + 0.25s + var(--i) * 0.07s) both;
  }

  /* Inner: idle bob, each on its own rhythm */
  .pop :global(img) {
    width: 100%;
    height: auto;
    rotate: var(--r);
    filter: drop-shadow(2px 6px 0 rgb(42 31 61 / 0.14));
    animation: bob var(--dur) ease-in-out calc(var(--i) * -0.6s) infinite alternate;
  }

  @keyframes pop-in {
    from {
      opacity: 0;
      transform: scale(0) rotate(-20deg);
    }
  }

  @keyframes bob {
    from {
      transform: translateY(-8px) rotate(-3deg);
    }
    to {
      transform: translateY(10px) rotate(3deg);
    }
  }

  /* ---------- Games grid ---------- */
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 340px), 1fr));
    gap: clamp(3.5rem, 5vw, 4.5rem) clamp(2.25rem, 4vw, 3.5rem);
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .card {
    --accent-ink: color-mix(in oklab, var(--accent) 55%, #2a1f3d);
    display: grid;
    gap: 1.9rem;
    color: inherit;
    text-decoration: none;
  }

  .card-text {
    display: grid;
    gap: 0.3rem;
  }

  .card:hover h3 {
    color: var(--accent-ink);
  }

  .status {
    margin-top: 0.2rem;
    font-size: var(--step--1);
    font-weight: 700;
    color: var(--accent-ink);
  }

  /* ---------- Studio ---------- */
  .studio {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    gap: clamp(2rem, 6vw, 5rem);
  }

  .studio > div:last-child {
    display: grid;
    gap: var(--space-m);
    justify-items: start;
  }

  .faces {
    display: flex;
  }

  .faces img {
    width: clamp(110px, 15vw, 160px);
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: 50%;
    border: 3px solid var(--ink);
    box-shadow: 4px 5px 0 var(--peach);
    transition: transform 0.35s var(--bounce);
  }

  .faces img:first-child {
    rotate: -4deg;
  }

  .faces img + img {
    margin-left: -1.4rem;
    rotate: 5deg;
  }

  .faces img:hover {
    transform: translateY(-8px) scale(1.05);
  }

  @media (max-width: 820px) {
    .studio {
      grid-template-columns: 1fr;
    }

    .floater:not(.keep-mobile) {
      display: none;
    }

    .floater {
      top: 1.25rem;
      width: clamp(52px, 16vw, 80px);
    }

    .hero {
      min-height: auto;
      padding-block: 4.5rem 3.5rem;
    }
  }
</style>

<script>
  function initHero() {
    const hero = document.getElementById('hero');
    const splash = document.getElementById('splash');
    if (!hero) return;

    if (splash && document.documentElement.hasAttribute('data-intro')) {
      splash.addEventListener('animationend', (e) => {
        if (e.animationName.includes('curtain-up')) {
          splash.remove();
        }
      });
    }

    // Gentle parallax: characters drift away from the pointer.
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const fine = window.matchMedia('(pointer: fine)').matches;
    if (reduce || !fine) return;
    let frame = 0;
    hero.addEventListener('pointermove', (e) => {
      cancelAnimationFrame(frame);
      frame = requestAnimationFrame(() => {
        const r = hero.getBoundingClientRect();
        hero.style.setProperty('--mx', (((e.clientX - r.left) / r.width) * 2 - 1).toFixed(3));
        hero.style.setProperty('--my', (((e.clientY - r.top) / r.height) * 2 - 1).toFixed(3));
      });
    });
    hero.addEventListener('pointerleave', () => {
      hero.style.setProperty('--mx', '0');
      hero.style.setProperty('--my', '0');
    });
  }

  document.addEventListener('astro:page-load', initHero);
</script>
