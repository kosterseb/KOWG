---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ClipFrame from '../components/ClipFrame.astro';
import NewsCard from '../components/NewsCard.astro';
import { site } from '../site';
import logo from '../assets/art/logo-full.png';
import Waves from '../components/Waves.astro';
import duo from '../assets/art/duo.png';
import fox from '../assets/art/fox.png';
import fish from '../assets/art/fish.png';
import wizard from '../assets/art/wizard.png';
import polar from '../assets/art/polar-bear.png';
import bunny from '../assets/art/umbrella-bunny.png';
import eye from '../assets/art/eye-detective.png';
import gnome from '../assets/art/gnome-bard.png';
import catKnight from '../assets/art/cat-knight.png';

const games = (await getCollection('games', ({ data }) => !data.draft)).sort((a, b) => a.data.order - b.data.order);
const news = (await getCollection('news', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);
const hv = site.heroVideo;

// Intro curtain: the gang pops in around the duo while the "loading" line bounces.
const gang = [fox, catKnight, wizard, fish, polar, eye, bunny, gnome];
const loadingText = 'Loading whimsy';

---

<Base autoHideNav>
  <!-- One-time intro curtain, shown on the first visit of a session -->
  <div class="splash" id="splash" aria-hidden="true" slot="overlay">
    <div class="stage">
      <div class="ring">
        {
          gang.map((img, i) => (
            <span class="buddy" style={`--a:${i * (360 / gang.length) - 90}deg; --i:${i}`}>
              <span class="buddy-pop">
                <Image src={img} alt="" width={120} densities={[1, 2]} loading="eager" />
              </span>
            </span>
          ))
        }
      </div>
      <Image class="duo" src={duo} alt="" width={200} densities={[1, 2]} loading="eager" />
    </div>
    <p class="display loading">
      {
        [...loadingText].map((ch, i) => (
          <span style={`--l:${i}`}>{ch === ' ' ? '\u00a0' : ch}</span>
        ))
      }
    </p>
    <svg class="squiggle" viewBox="0 0 240 20" fill="none">
      <path d="M4 12 C 24 2, 40 18, 60 10 S 96 2, 118 11 S 156 19, 178 9 S 216 3, 236 11" pathLength="1"></path>
    </svg>
    <Waves edge="bottom" class="splash-waves" />
  </div>
  <script is:inline>
    (function () {
      var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      try {
        if (!reduce && !sessionStorage.getItem('kowg-intro')) {
          document.documentElement.setAttribute('data-intro', '');
          sessionStorage.setItem('kowg-intro', '1');
        }
      } catch (e) {}
    })();
  </script>

  <section class="hero" id="hero" aria-labelledby="hero-title" style={`--wash:${hv.wash}`}>
    {
      hv.mp4 && (
        <div class="hero-video" aria-hidden="true">
          <video data-loop muted loop playsinline preload="metadata" poster={hv.poster || undefined}>
            {hv.webm && <source src={hv.webm} type="video/webm" />}
            <source src={hv.mp4} type="video/mp4" />
          </video>
        </div>
      )
    }
    <div class="hero-center">
      <Image
        class="logo"
        src={logo}
        alt="Kinda Whimsical Games"
        width={460}
        densities={[1, 2]}
        loading="eager"
        fetchpriority="high"
      />
      <h1 id="hero-title" class="hero-title">We make the games we wish&nbsp;existed</h1>
      <div class="btn-row hero-cta">
        <a class="btn" href="/games/">See our games</a>
        <a class="btn btn--ghost" href="/about/">Meet the studio</a>
      </div>
    </div>
  </section>

  {
    news.length > 0 && (
      <section class="section wrap news" aria-labelledby="news-title">
        <div class="section-head">
          <h2 id="news-title">Latest news</h2>
          <a href="/news/">All news</a>
        </div>
        <div class="news-grid">
          {news.map((post, i) => <NewsCard post={post} index={i} />)}
        </div>
      </section>
    )
  }

  <section class="section games" aria-labelledby="games-title">
    <div class="wrap">
      <div class="section-head">
        <h2 id="games-title">Our games</h2>
        <a href="/games/">See them all</a>
      </div>
      <ul class="grid">
        {
          games.map((game, i) => (
            <li
              style={`--accent:${game.data.color}; --reveal-delay:${(i % 3) * 0.08}s; --reveal-tilt:${i % 2 ? 2 : -2}deg`}
              data-reveal
            >
              <a class="card" href={`/games/${game.id}/`}>
                <ClipFrame game={game} tilt={i % 2 ? 0.6 : -0.6} stickerSide={i % 2 ? 'left' : 'right'} />
                <div class="card-text">
                  <h3>{game.data.title}</h3>
                  <p class="muted">{game.data.tagline}</p>
                  <p class="status">{game.data.status}</p>
                </div>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Base>

<style>
  /* ---------- Intro curtain ---------- */
  .splash {
    display: none;
  }

  :global(html[data-intro]) .splash {
    position: fixed;
    inset: 0;
    z-index: 300;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 1.25rem;
    background: radial-gradient(circle at 50% 42%, #3a2b57 0%, var(--plum) 62%);
    color: var(--chalk);
    animation: curtain-up 0.75s cubic-bezier(0.7, 0, 0.3, 1) 2.05s forwards;
  }

  .stage {
    --r: clamp(124px, 28vw, 230px);
    position: relative;
    width: calc(var(--r) * 2 + 110px);
    height: calc(var(--r) * 2 + 60px);
    display: grid;
    place-items: center;
  }

  /* The whole ring slowly turns, the characters stay upright */
  .ring {
    position: absolute;
    inset: 0;
    animation: spin 14s linear infinite;
  }

  .buddy {
    position: absolute;
    left: 50%;
    top: 50%;
    width: clamp(64px, 12vw, 112px);
    margin: calc(clamp(64px, 12vw, 112px) / -2);
    transform: rotate(var(--a)) translateX(var(--r)) rotate(calc(var(--a) * -1));
  }

  .buddy-pop {
    display: block;
    animation:
      unspin 14s linear infinite,
      buddy-in 0.5s var(--bounce) calc(0.15s + var(--i) * 0.12s) both;
  }

  .buddy-pop :global(img) {
    width: 100%;
    height: auto;
    filter: drop-shadow(0 4px 0 rgb(0 0 0 / 0.25));
    animation: jiggle calc(0.9s + var(--i) * 0.07s) ease-in-out calc(var(--i) * -0.2s) infinite alternate;
  }

  .duo {
    position: relative;
    width: clamp(130px, 22vw, 200px);
    height: auto;
    animation:
      duo-in 0.6s var(--bounce) both,
      hop 0.5s ease-in-out 0.6s infinite alternate;
  }

  .loading {
    display: flex;
    font-size: clamp(1.2rem, 1rem + 1vw, 1.6rem);
    letter-spacing: 0.04em;
  }

  .loading span {
    display: inline-block;
    animation: letter 1.1s ease-in-out calc(var(--l) * 0.07s) infinite;
  }

  /* Crayon line that draws itself like a progress bar */
  .squiggle {
    width: clamp(160px, 30vw, 240px);
    margin-top: -0.6rem;
  }

  .squiggle path {
    stroke: var(--peach);
    stroke-width: 3.5;
    stroke-linecap: round;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    animation: draw 1.8s cubic-bezier(0.5, 0, 0.3, 1) 0.2s forwards;
  }

    @keyframes curtain-up {
    to {
      transform: translateY(calc(-100% - 44px));
      visibility: hidden;
    }
  }

  @keyframes spin {
    to {
      rotate: 360deg;
    }
  }

  @keyframes unspin {
    to {
      rotate: -360deg;
    }
  }

  @keyframes buddy-in {
    from {
      opacity: 0;
      transform: scale(0) rotate(-30deg);
    }
  }

  @keyframes jiggle {
    from {
      transform: translateY(-4px) rotate(-6deg);
    }
    to {
      transform: translateY(4px) rotate(6deg);
    }
  }

  @keyframes duo-in {
    from {
      opacity: 0;
      transform: scale(0.3) rotate(-20deg);
    }
  }

  @keyframes hop {
    from {
      translate: 0 0;
      rotate: -4deg;
    }
    to {
      translate: 0 -14px;
      rotate: 4deg;
    }
  }

  @keyframes letter {
    0%,
    60%,
    100% {
      transform: translateY(0);
    }
    30% {
      transform: translateY(-9px) rotate(-4deg);
      color: var(--peach);
    }
  }

  @keyframes draw {
    to {
      stroke-dashoffset: 0;
    }
  }

  /* ---------- Hero ---------- */
  .hero {
    --start: 0s; /* pushed back while the curtain is up */
    position: relative;
    min-height: min(100svh, 940px);
    display: grid;
    place-items: center;
    padding: clamp(1.75rem, 5svh, 4rem) 1.25rem;
    overflow: hidden;
  }

  :global(html[data-intro]) .hero {
    --start: 2.4s;
  }

  .hero-center {
    position: relative;
    z-index: 2;
    display: grid;
    justify-items: center;
    gap: clamp(0.9rem, 2.6svh, 1.6rem);
    text-align: center;
  }

  /* Logo is sized by screen height too, so logo, line and buttons always fit in the first view */
  .logo {
    width: max(180px, min(440px, 72vw, calc((100svh - 300px) / 1.16)));
    height: auto;
    transform-origin: 50% 85%;
    animation: logo-in 1s var(--bounce) var(--start) both;
  }

  .hero-title {
    font-size: clamp(1.6rem, min(1rem + 2.4vw, 5.4svh), 2.9rem);
    max-width: 20ch;
    animation: rise 0.7s var(--bounce) calc(var(--start) + 0.35s) both;
  }

  .hero-cta {
    justify-content: center;
    animation: rise 0.7s var(--bounce) calc(var(--start) + 0.5s) both;
  }

  @keyframes logo-in {
    0% {
      opacity: 0;
      transform: scale(0.6) rotate(-10deg);
    }
    60% {
      opacity: 1;
      transform: scale(1.04) rotate(3deg);
    }
    100% {
      transform: none;
    }
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
  }

  .hero-video {
    position: absolute;
    inset: 0;
  }

  .hero-video video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Paper wash over the video so the logo and text stay readable */
  .hero-video::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--paper);
    opacity: var(--wash);
  }

  /* ---------- Games grid ---------- */
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 340px), 1fr));
    gap: clamp(3.5rem, 5vw, 4.5rem) clamp(2.25rem, 4vw, 3.5rem);
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .card {
    --accent-ink: color-mix(in oklab, var(--accent) 55%, #2a1f3d);
    display: grid;
    gap: 1.9rem;
    color: inherit;
    text-decoration: none;
  }

  .card-text {
    display: grid;
    gap: 0.3rem;
  }

  .card:hover h3 {
    color: var(--accent-ink);
  }

  .status {
    margin-top: 0.2rem;
    font-size: var(--step--1);
    font-weight: 700;
    color: var(--accent-ink);
  }

  /* ---------- News ---------- */
  .news {
    padding-top: var(--space-l);
  }

  .news-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr));
    gap: clamp(2.5rem, 4vw, 3.5rem) clamp(1.75rem, 3vw, 2.5rem);
    padding-top: 0.5rem;
  }

  /* Games sit on a slightly darker sheet at the bottom of the page */
  .games {
    background: var(--paper-2);
    margin-top: var(--space-l);
    clip-path: polygon(0 18px, 12% 6px, 30% 16px, 48% 4px, 66% 14px, 84% 2px, 100% 12px, 100% 100%, 0 100%);
  }

  :global(main:has(> .games:last-child) + .site-footer) {
    margin-top: 0;
  }

  @media (max-width: 820px) {

    .hero {
      min-height: auto;
      padding-block: 4.5rem 3.5rem;
    }
  }
</style>

<script>
  function initHero() {
    const hero = document.getElementById('hero');
    const splash = document.getElementById('splash');
    if (!hero) return;

    if (splash && document.documentElement.hasAttribute('data-intro')) {
      splash.addEventListener('animationend', (e) => {
        if (e.animationName.includes('curtain-up')) {
          splash.remove();
        }
      });
    }
  }

  document.addEventListener('astro:page-load', initHero);
</script>
