---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import GameRow from '../../components/GameRow.astro';

const games = (await getCollection('games', ({ data }) => !data.draft)).sort((a, b) => a.data.order - b.data.order);
---

<Base title="Games" description="Games from Kinda Whimsical Games, starting with Grain.">
  <header class="wrap intro">
    <h1>Our games</h1>
    <p class="lede">
      Grain is the first game we're showing. There's more on the drawing board, and we'll share it when it's
      ready. Clips are captured straight from the current build.
    </p>
  </header>
  <div class="wrap list">
    {games.map((game, i) => <GameRow game={game} index={i} />)}
  </div>
</Base>

<style>
  .intro {
    display: grid;
    gap: var(--space-m);
    padding-block: clamp(2rem, 6vw, 4.5rem) var(--space-l);
  }

  .list {
    display: grid;
    gap: clamp(5rem, 10vw, 8.5rem);
    padding-block: var(--space-l);
  }
</style>
