---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ClipFrame from '../../components/ClipFrame.astro';

export async function getStaticPaths() {
  const games = await getCollection('games', ({ data }) => !data.draft);
  return games.map((game) => ({ params: { slug: game.id }, props: { game } }));
}

interface Props {
  game: CollectionEntry<'games'>;
}

const { game } = Astro.props;
const { Content } = await render(game);
const { title, tagline, status, genres, platforms, color, trailer, gallery, links, poster } = game.data;

const all = (await getCollection('games', ({ data }) => !data.draft)).sort((a, b) => a.data.order - b.data.order);
const i = all.findIndex((g) => g.id === game.id);
const next = all[(i + 1) % all.length];
---

<Base title={title} description={`${title}: ${tagline}`} image={poster}>
  <article style={`--accent:${color}`}>
    <header class="wrap head">
      <a class="back" href="/games/">All games</a>
      <h1>{title}</h1>
      <p class="lede">{tagline}</p>
    </header>

    <div class="wrap hero-clip">
      <ClipFrame game={game} tilt={-0.5} eager />
    </div>

    <div class="wrap body">
      <div class="prose">
        <Content />
        {
          links.length > 0 && (
            <div class="btn-row">
              {links.map((l, n) => (
                <a class:list={['btn', { 'btn--ghost': n > 0 }]} href={l.url} target="_blank" rel="noopener">
                  {l.label}
                </a>
              ))}
            </div>
          )
        }
      </div>
      <dl class="facts">
        <div>
          <dt>Status</dt>
          <dd class="status">{status}</dd>
        </div>
        {
          genres.length > 0 && (
            <div>
              <dt>Genre</dt>
              <dd>{genres.join(', ')}</dd>
            </div>
          )
        }
        {
          platforms.length > 0 && (
            <div>
              <dt>Platforms</dt>
              <dd>{platforms.join(', ')}</dd>
            </div>
          )
        }
      </dl>
    </div>

    {
      trailer && (
        <section class="wrap block" aria-labelledby="trailer-title">
          <h2 id="trailer-title">Trailer</h2>
          <div class="video">
            <iframe
              src={`https://www.youtube-nocookie.com/embed/${trailer}`}
              title={`${title} trailer`}
              loading="lazy"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
              allowfullscreen
            />
          </div>
        </section>
      )
    }

    {
      gallery.length > 0 && (
        <section class="wrap block" aria-labelledby="gallery-title">
          <h2 id="gallery-title">Screenshots</h2>
          <ul class="gallery">
            {gallery.map((g) => (
              <li>
                <a href={g.src} target="_blank">
                  <img src={g.src} alt={g.alt} loading="lazy" decoding="async" />
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      next && next.id !== game.id && (
        <nav class="wrap next" aria-label="Next game">
          <span class="muted">Next up</span>
          <a href={`/games/${next.id}/`} style={`--accent:${next.data.color}`}>
            {next.data.title}
          </a>
        </nav>
      )
    }
  </article>
</Base>

<style>
  .head {
    display: grid;
    gap: 0.9rem;
    justify-items: start;
    padding-block: clamp(1.5rem, 5vw, 3.5rem) var(--space-l);
  }

  .head h1 {
    color: var(--accent);
    font-size: clamp(3rem, 1.5rem + 6vw, 6.5rem);
    font-weight: 750;
  }

  .back {
    font-weight: 600;
    font-size: var(--step--1);
    color: var(--chalk-dim);
  }

  .hero-clip {
    max-width: 1000px;
  }

  .body {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(220px, 1fr);
    gap: clamp(2rem, 6vw, 6rem);
    padding-top: clamp(4rem, 8vw, 6rem);
  }

  .prose {
    display: grid;
    gap: 1.5rem;
    align-content: start;
    font-size: 1.15rem;
  }

  .prose :global(p + p) {
    margin-top: 0;
  }

  .facts {
    display: grid;
    gap: 1.25rem;
    align-content: start;
    margin: 0;
    padding: 1.5rem;
    border: 2px dashed var(--plum-700);
    border-radius: var(--wobble-radius);
  }

  dt {
    font-size: var(--step--1);
    color: var(--chalk-dim);
  }

  dd {
    margin: 0.1rem 0 0;
    font-weight: 600;
  }

  dd.status {
    color: var(--accent);
  }

  .block {
    display: grid;
    gap: var(--space-m);
    padding-top: var(--space-xl);
  }

  .video {
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: var(--wobble-radius);
    background: var(--plum-800);
  }

  .video iframe {
    width: 100%;
    height: 100%;
    border: 0;
  }

  .gallery {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 280px), 1fr));
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .gallery img {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: 14px;
  }

  .next {
    display: grid;
    gap: 0.2rem;
    padding-top: var(--space-xl);
  }

  .next a {
    font-family: var(--font-display);
    font-variation-settings: 'SOFT' 100, 'WONK' 1;
    font-weight: 700;
    font-size: var(--step-3);
    color: var(--accent);
    text-decoration: none;
    justify-self: start;
  }

  .next a:hover {
    text-decoration: underline;
  }

  @media (max-width: 820px) {
    .body {
      grid-template-columns: 1fr;
    }
  }
</style>
