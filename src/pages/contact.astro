---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { site, socialLabels, type SocialKey } from '../site';
import umbrella from '../assets/art/umbrella-bunny.png';

const socials = (Object.keys(site.socials) as SocialKey[])
  .filter((k) => site.socials[k])
  .map((k) => ({ label: socialLabels[k], url: site.socials[k] }));
---

<Base title="Contact" description="Get in touch with Kinda Whimsical Games.">
  <section class="wrap contact">
    <div class="text">
      <h1>Say hello</h1>
      <p class="lede">
        Want to playtest, write about one of our games, work with us, or just tell us what you think? Send us an email.
        We read everything.
      </p>
      <p class="mail"><a href={`mailto:${site.email}`}>{site.email}</a></p>
      {
        socials.length > 0 && (
          <div>
            <p class="muted">Or find us here:</p>
            <ul class="btn-row">
              {socials.map((s) => (
                <li>
                  <a class="btn btn--ghost" href={s.url} target="_blank" rel="noopener">
                    {s.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )
      }
    </div>
    <Image class="art" src={umbrella} alt="" width={360} />
  </section>
</Base>

<style>
  .contact {
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
    gap: var(--space-l);
    align-items: center;
    padding-block: clamp(3rem, 8vw, 6rem);
  }

  .text {
    display: grid;
    gap: var(--space-m);
  }

  .mail {
    font-family: var(--font-display);
    font-variation-settings: 'SOFT' 100, 'WONK' 1;
    font-weight: 650;
    font-size: clamp(1.4rem, 1rem + 2vw, 2.3rem);
    overflow-wrap: anywhere;
  }

  .btn-row {
    margin: 0.6rem 0 0;
    padding: 0;
    list-style: none;
  }

  .art {
    width: 100%;
    max-width: 320px;
    justify-self: center;
    animation: drift 6s ease-in-out infinite alternate;
  }

  @keyframes drift {
    from {
      transform: translateY(0) rotate(-3deg);
    }
    to {
      transform: translateY(-14px) rotate(3deg);
    }
  }

  @media (max-width: 720px) {
    .contact {
      grid-template-columns: 1fr;
    }

    .art {
      max-width: 200px;
      order: -1;
    }
  }
</style>
