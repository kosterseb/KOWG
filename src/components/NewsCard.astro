---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { getEntry, type CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'news'>;
  index?: number;
}

const { post, index = 0 } = Astro.props;
const { title, date, summary, image, imageAlt, sticker } = post.data;
const game = post.data.game ? await getEntry(post.data.game) : undefined;
const accent = game?.data.color ?? '#F5B48C';

const art = import.meta.glob<{ default: ImageMetadata }>('../assets/art/*.png', { eager: true });
const stickerImg = sticker ? art[`../assets/art/${sticker}.png`]?.default : undefined;

const tilt = [-1.2, 0.9, -0.6][index % 3];
const dateLabel = date.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
---

<a
  class="note"
  href={`/news/${post.id}/`}
  style={`--accent:${accent}; --tilt:${tilt}deg; --reveal-delay:${(index % 3) * 0.08}s; --reveal-tilt:${tilt * 2}deg`}
  data-reveal
>
  <span class="tape" aria-hidden="true"></span>
  <div class="cover">
    {
      image ? (
        <img src={image} alt={imageAlt ?? ''} loading="lazy" decoding="async" />
      ) : stickerImg ? (
        <Image src={stickerImg} alt="" width={220} densities={[1, 2]} class="sticker" />
      ) : null
    }
  </div>
  <div class="text">
    <p class="meta">
      <time datetime={date.toISOString()}>{dateLabel}</time>
      {game && <span class="game">{game.data.title}</span>}
    </p>
    <h3>{title}</h3>
    <p class="summary">{summary}</p>
  </div>
</a>

<style>
  .note {
    --accent-ink: color-mix(in oklab, var(--accent) 55%, var(--accent-mix, #2a1f3d));
    position: relative;
    display: grid;
    grid-template-rows: auto 1fr;
    color: inherit;
    text-decoration: none;
    background: #faf7f1;
    border-radius: 6px 10px 8px 12px;
    box-shadow:
      0 1px 0 var(--line),
      3px 6px 0 rgb(42 31 61 / 0.08);
    rotate: var(--tilt);
    transition:
      rotate 0.35s var(--bounce),
      translate 0.35s var(--bounce),
      box-shadow 0.35s ease;
  }

  .note:hover,
  .note:focus-visible {
    rotate: 0deg;
    translate: 0 -6px;
    box-shadow:
      0 1px 0 var(--line),
      6px 12px 0 rgb(42 31 61 / 0.12);
  }

  /* A strip of masking tape holding the note to the page */
  .tape {
    position: absolute;
    z-index: 2;
    top: -12px;
    left: 50%;
    width: 92px;
    height: 26px;
    translate: -50% 0;
    rotate: calc(var(--tilt) * -3);
    background: color-mix(in oklab, var(--accent) 55%, transparent);
    clip-path: polygon(3% 8%, 97% 0, 100% 92%, 0 100%);
  }

  .cover {
    position: relative;
    aspect-ratio: 16 / 10;
    margin: 0.75rem 0.75rem 0;
    overflow: hidden;
    border-radius: 4px 8px 6px 10px;
    background:
      repeating-linear-gradient(-35deg, transparent 0 12px, color-mix(in oklab, var(--accent) 26%, transparent) 12px 14px),
      color-mix(in oklab, var(--accent) 20%, var(--paper));
    display: grid;
    place-items: center;
  }

  .cover > img:not(.sticker) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .cover .sticker {
    width: 46%;
    height: auto;
    filter: drop-shadow(2px 5px 0 rgb(42 31 61 / 0.15));
    transition: transform 0.4s var(--bounce);
  }

  .note:hover .sticker {
    transform: rotate(-6deg) scale(1.08);
  }

  .text {
    display: grid;
    gap: 0.45rem;
    align-content: start;
    padding: 1.1rem 1.25rem 1.4rem;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem 0.75rem;
    font-size: var(--step--1);
    font-weight: 650;
    color: var(--ink-dim);
  }

  .game {
    color: var(--accent-ink);
  }

  h3 {
    font-size: var(--step-1);
  }

  .summary {
    color: var(--ink-dim);
  }
</style>
