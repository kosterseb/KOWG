---
import { Image } from 'astro:assets';
import { site } from '../site';
import Waves from './Waves.astro';
import gnome from '../assets/art/gnome-bard.png';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <Waves edge="top" />
  <div class="wrap row">
    <p class="display name">Kinda Whimsical Games</p>
    <p>Copenhagen, Denmark</p>
    <p><a href={`mailto:${site.email}`}>{site.email}</a></p>
    <p class="small">© {year}</p>
  </div>
  <Image class="fish" src={gnome} alt="" width={160} densities={[1, 2]} />
</footer>

<style>
  .site-footer {
    position: relative;
    margin-top: var(--space-xl);
    padding-block: 2rem;
    background: var(--plum);
    color: var(--chalk);
  }

  .row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem 2.5rem;
    padding-right: 140px;
  }

  .row p {
    margin: 0;
    font-size: var(--step--1);
  }

  .row .name {
    font-size: 1rem;
  }

  .small {
    color: color-mix(in oklab, var(--chalk) 70%, var(--plum));
  }

  .small {
    font-size: var(--step--1);
  }

  a {
    color: var(--chalk);
  }

  .fish {
    z-index: 1;
    position: absolute;
    right: 4%;
    top: -52px;
    width: 120px;
    transform: rotate(-12deg);
    transition: transform 0.4s var(--bounce);
  }

  .site-footer:hover .fish {
    transform: rotate(-4deg) translateY(-10px);
  }

  @media (max-width: 640px) {
    .row {
      flex-direction: column;
      gap: 0.35rem;
      padding-right: 90px;
    }

    .fish {
      width: 84px;
      top: -40px;
    }
  }
</style>
