---
import { site, socialLabels, type SocialKey } from '../site';

const socials = (Object.keys(site.socials) as SocialKey[])
  .filter((k) => site.socials[k])
  .map((k) => ({ label: socialLabels[k], url: site.socials[k] }));
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap row">
    <p>
      <strong>{site.name}</strong><br />
      <span class="muted">Drawn by hand, built by two.</span>
    </p>
    <ul>
      <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
      {
        socials.map((s) => (
          <li>
            <a href={s.url} rel="me noopener" target="_blank">
              {s.label}
            </a>
          </li>
        ))
      }
    </ul>
    <p class="muted small">© {year}</p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: var(--space-xl);
    padding-block: var(--space-l);
    border-top: 2px dashed var(--plum-700);
  }

  .row {
    display: flex;
    flex-wrap: wrap;
    align-items: start;
    justify-content: space-between;
    gap: var(--space-m);
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .small {
    font-size: var(--step--1);
  }
</style>
