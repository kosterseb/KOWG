---
import { Image } from 'astro:assets';
import { site, socialLabels, type SocialKey } from '../site';
import gnome from '../assets/art/gnome-bard.png';

const socials = (Object.keys(site.socials) as SocialKey[])
  .filter((k) => site.socials[k])
  .map((k) => ({ label: socialLabels[k], url: site.socials[k] }));
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <svg class="edge" viewBox="0 0 1440 24" preserveAspectRatio="none" aria-hidden="true">
    <path d="M0 24 H1440 V12 C1320 2 1200 18 1060 10 C920 2 800 18 660 10 C520 2 400 18 260 11 C150 5 70 14 0 9 Z"></path>
  </svg>
  <div class="wrap row">
    <div class="sign">
      <p class="display name">Kinda Whimsical Games</p>
      <p class="tag">Drawn by hand, built by two.</p>
    </div>
    <ul>
      <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
      {
        socials.map((s) => (
          <li>
            <a href={s.url} rel="me noopener" target="_blank">
              {s.label}
            </a>
          </li>
        ))
      }
    </ul>
    <p class="small">© {year}</p>
  </div>
  <Image class="fish" src={gnome} alt="" width={160} densities={[1, 2]} />
</footer>

<style>
  .site-footer {
    position: relative;
    margin-top: var(--space-xl);
    padding-block: var(--space-l);
    background: var(--plum);
    color: var(--chalk);
  }

  .edge {
    position: absolute;
    left: 0;
    bottom: 100%;
    width: 100%;
    height: 18px;
    fill: var(--plum);
  }

  .row {
    display: flex;
    flex-wrap: wrap;
    align-items: start;
    justify-content: space-between;
    gap: var(--space-m);
  }

  .name {
    font-size: 1.1rem;
  }

  .tag,
  .small {
    color: color-mix(in oklab, var(--chalk) 70%, var(--plum));
  }

  .small {
    font-size: var(--step--1);
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  a {
    color: var(--chalk);
  }

  .fish {
    position: absolute;
    right: 4%;
    top: -52px;
    width: 120px;
    transform: rotate(-12deg);
    transition: transform 0.4s var(--bounce);
  }

  .site-footer:hover .fish {
    transform: rotate(-4deg) translateY(-10px);
  }

  @media (max-width: 640px) {
    .fish {
      width: 84px;
      top: -40px;
    }
  }
</style>
