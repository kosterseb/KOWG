---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  game: CollectionEntry<'games'>;
  /** Tilt the frame slightly; alternates nicely in lists. */
  tilt?: number;
  stickerSide?: 'left' | 'right';
  eager?: boolean;
}

const { game, tilt = 0, stickerSide = 'right', eager = false } = Astro.props;
const { title, clip, poster, color, sticker } = game.data;

const art = import.meta.glob<{ default: ImageMetadata }>('../assets/art/*.png', { eager: true });
const stickerImg = sticker ? art[`../assets/art/${sticker}.png`]?.default : undefined;

const isVideo = clip ? /\.(mp4|webm|mov)$/i.test(clip) : false;
const webm = isVideo && clip?.endsWith('.mp4') ? clip.replace(/\.mp4$/i, '.webm') : undefined;
---

<div class="frame" style={`--accent:${color}; --tilt:${tilt}deg`}>
  <div class="media">
    {
      isVideo ? (
        <video data-loop muted loop playsinline preload="metadata" poster={poster} aria-label={`${title} gameplay clip`}>
          {webm && game.data.clip && <source src={webm} type="video/webm" />}
          <source src={clip} type={clip!.endsWith('.webm') ? 'video/webm' : 'video/mp4'} />
        </video>
      ) : clip ? (
        <img src={clip} alt={`${title} gameplay`} loading={eager ? 'eager' : 'lazy'} decoding="async" />
      ) : poster ? (
        <img src={poster} alt={`${title} screenshot`} loading={eager ? 'eager' : 'lazy'} decoding="async" />
      ) : (
        <div class="placeholder">
          <span class="ph-title">{title}</span>
          <span class="ph-note">Footage on the way</span>
        </div>
      )
    }
  </div>
  {
    stickerImg && (
      <Image
        class:list={['sticker', stickerSide]}
        src={stickerImg}
        alt=""
        width={260}
        loading={eager ? 'eager' : 'lazy'}
      />
    )
  }
</div>

<style>
  .frame {
    --accent-ink: color-mix(in oklab, var(--accent) 55%, #2a1f3d);
    position: relative;
    transform: rotate(var(--tilt));
  }

  /* Offset colour block behind the clip, like a slightly misprinted sticker */
  .frame::before {
    content: '';
    position: absolute;
    inset: 0;
    translate: 12px 12px;
    background: var(--accent);
    border-radius: var(--wobble-radius);
    filter: url(#crayon);
    transition: translate 0.35s var(--bounce);
  }

  .media {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: var(--wobble-radius);
    background: var(--paper-2);
    container-type: inline-size;
  }

  .media > video,
  .media > img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Inked outline, distorted so it never looks ruler-straight */
  .frame::after {
    content: '';
    position: absolute;
    inset: -4px;
    border: 3px solid var(--ink);
    border-radius: var(--wobble-radius);
    filter: url(#crayon);
    pointer-events: none;
  }

  .placeholder {
    position: absolute;
    inset: 0;
    display: grid;
    place-content: center;
    gap: 0.5rem;
    text-align: center;
    background:
      repeating-linear-gradient(-35deg, transparent 0 14px, color-mix(in oklab, var(--accent) 28%, transparent) 14px 17px),
      color-mix(in oklab, var(--accent) 22%, var(--paper));
  }

  .ph-title {
    font-family: var(--font-display);
    font-variation-settings: 'SOFT' 100, 'WONK' 1;
    font-weight: 800;
    text-transform: uppercase;
    font-size: clamp(1.4rem, 10cqi, 4.4rem);
    line-height: 1;
    padding-inline: 1rem;
    color: var(--accent-ink);
  }

  .ph-note {
    font-size: var(--step--1);
    font-weight: 650;
    color: var(--ink-dim);
  }

  .sticker {
    position: absolute;
    z-index: 2;
    width: clamp(90px, 22%, 170px);
    height: auto;
    bottom: -14%;
    filter: drop-shadow(2px 5px 0 rgb(42 31 61 / 0.18));
    transition: transform 0.35s var(--bounce);
    pointer-events: none;
  }

  .sticker.right {
    right: -5%;
    transform: rotate(6deg);
  }

  .sticker.left {
    left: -5%;
    transform: rotate(-6deg);
  }

  :global(a:hover) > .frame::before,
  :global(a:focus-visible) > .frame::before {
    translate: 18px 16px;
  }

  :global(a:hover) > .frame .sticker.right,
  :global(a:focus-visible) > .frame .sticker.right {
    transform: rotate(-4deg) translateY(-14px) scale(1.06);
  }

  :global(a:hover) > .frame .sticker.left,
  :global(a:focus-visible) > .frame .sticker.left {
    transform: rotate(4deg) translateY(-14px) scale(1.06);
  }
</style>
